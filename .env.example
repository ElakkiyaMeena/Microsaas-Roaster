# Assignment Roaster - environment configuration
# Copy to .env and fill in values:  cp .env.example .env
# Never commit .env.

# ---------- Runtime ----------
# "production" makes the API refuse to start with a placeholder/short SECRET_KEY.
# docker-compose.yml defaults this to production; docker-compose.dev.yml forces development.
ENVIRONMENT=development

# ---------- Database ----------
# Used by docker-compose to configure the postgres container.
DB_USER=postgres
# REQUIRED for docker-compose.yml (no default). Use a strong, unique password in production;
# docker-compose.dev.yml falls back to "postgres" when unset.
DB_PASSWORD=
DB_NAME=assignment_roaster
# Local (non-docker) connection string. docker-compose overrides this to point at the `db` service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assignment_roaster

# ---------- Auth ----------
# REQUIRED. At least 32 characters; placeholder values are rejected when ENVIRONMENT=production.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Google OAuth (optional; leave empty to disable) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- OpenAI ----------
# Required to generate roasts. Server-side only - never exposed to the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
# Cap on completion tokens per OpenAI call (cost control; truncated output is retried once)
OPENAI_MAX_OUTPUT_TOKENS=3000
# Max roasts per user per day (HTTP 429 when exceeded)
ROASTS_PER_DAY=10
# Roast output language: tanglish (Tamil + English in Latin script) or english
ROAST_LANGUAGE=tanglish

# ---------- Uploads ----------
UPLOAD_DIR=./uploads
# 1 MB per file
MAX_FILE_SIZE_BYTES=1048576
# 5 MB per zip
MAX_ZIP_SIZE_BYTES=5242880
MAX_FILES_PER_SUBMISSION=20
# Max characters of code sent to the AI (~100 KB)
MAX_CODE_CHARS=100000

# ---------- GitHub (Roast a commit) ----------
# Optional. Without a token the GitHub API allows 60 requests/hour per server IP; a token
# (fine-grained, read-only "Contents" access is enough) raises that to 5000/hour and lets
# users roast commits from private repos the token can read. Server-side only, never logged.
GITHUB_TOKEN=
# Timeout for GitHub API calls in seconds
GITHUB_TIMEOUT_SECONDS=10

# ---------- Rate limiting / proxy ----------
RATE_LIMIT_ENABLED=true
# IPs whose X-Forwarded-For headers uvicorn trusts (docker image). "*" is fine when the API is
# only reachable through the nginx proxy (as in docker-compose.yml); otherwise set the proxy IP.
FORWARDED_ALLOW_IPS=*
# Max request body size in bytes (25 MB); larger requests are rejected with 413.
MAX_REQUEST_BYTES=26214400

# ---------- URLs / CORS ----------
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ---------- Frontend (Vite, build-time) ----------
# Leave empty in docker-compose.yml builds so the SPA uses same-origin /api via nginx.
VITE_API_URL=http://localhost:8000
